---
// Self-hosted fonts (latin subset, woff2, our own origin — no CDN).
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = 'Ethan Justice — cloud security analyst. Governs cloud environments for a Fortune 500 insurer and runs a production-grade homelab.',
  path = '/',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = site + path;

const navLinks = [
  { href: '/projects/makimono/', label: 'makimono' },
  { href: '/projects/jarvis/', label: 'jarvis' },
  { href: '/projects/homelab/', label: 'homelab' },
  { href: '/projects/mealie/', label: 'mealie' },
  { href: '/projects/cloud-security/', label: 'cloud-security' },
  { href: '/about/', label: 'about' },
];

const current = path;
const year = new Date().getFullYear();

// Brand marks as inline paths: no icon font, no CDN, no extra request.
const GITHUB_PATH =
  'M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z';
const LINKEDIN_PATH =
  'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark light" />

    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + '/og.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site + '/og.png'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="navbar" data-navbar aria-label="Primary">
        <a class="brand" href="/">
          <span class="dot" aria-hidden="true"></span>
          ethan.justice
        </a>

        <ul class="nav">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="nav-socials">
            <a href="https://github.com/Tsuji-Hub" aria-label="GitHub" rel="me">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
            </a>
            <a href="https://www.linkedin.com/in/justice-ethan" aria-label="LinkedIn" rel="me">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LINKEDIN_PATH} /></svg>
            </a>
          </li>
        </ul>

        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="nav-panel"
          aria-label="Open menu"
        >
          <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </nav>

      <div class="nav-panel" id="nav-panel" data-nav-panel>
        <ul>
          {navLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="https://github.com/Tsuji-Hub" rel="me">github</a></li>
          <li><a href="https://www.linkedin.com/in/justice-ethan" rel="me">linkedin</a></li>
        </ul>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Static site. No trackers. Self-hosted fonts. CSP enforced.
          <a href="https://github.com/Tsuji-Hub/portfolio">View source</a>.
        </p>
        <p class="footer-links">
          <a href="mailto:justice.ethan04@gmail.com">email</a>
          <a href="https://www.linkedin.com/in/justice-ethan" rel="me">linkedin</a>
          <a href="https://github.com/Tsuji-Hub" rel="me">github</a>
          <span>© {year} Ethan Justice</span>
        </p>
      </div>
    </footer>

    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>
