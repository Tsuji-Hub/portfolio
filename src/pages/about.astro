---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';

// Structure follows the About-page research (claude/portfolio-research-about.md):
// a short top block with a real photo, a dated Now block, positions with
// receipts, how I work, what I was wrong about, a timeline, then the rest.
// Every fact here is checked against the résumé, the evidence file or a
// public source; nothing is padded.

const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const now = [
  { text: 'Going deeper on Torq: building security automation workflows past the practitioner certification.' },
  { text: 'Attacking every control in my homelab and publishing what held.', href: '/projects/security/', cta: 'the results' },
  { text: 'Rebuilding this site one page at a time, every number checked against a live source.' },
];

const work = [
  {
    t: 'I attack my own controls before I trust them.',
    d: 'A control counts once it has stopped something from outside, on the record. Four of mine failed that test the first time.',
    href: '/projects/security/',
  },
  {
    t: 'Detect, tune, then enforce.',
    d: 'New controls start in audit or detection-only mode against real traffic. They move to blocking when the false positives are known, not before.',
  },
  {
    t: 'Every risky change ships with its way back.',
    d: 'Firewall rollouts go host by host with a ten-minute auto-revert armed. Updates keep a rollback image and a snapshot until the new version has run for a few days.',
  },
  {
    t: 'Write it down while it happens.',
    d: 'Changes, tests and decisions go into a dated log as I make them, so the next person, usually me, does not have to guess.',
  },
];

const wrong = [
  {
    was: 'My VPN isolation held because no other route existed.',
    now: 'The route existed. What holds is a default-drop firewall in the namespace, and I trust it because I took the tunnel down six times and nothing got out.',
    href: '/projects/homelab/',
  },
  {
    was: 'fail2ban was banning attackers at my edge.',
    now: 'It logged bans and enforced none: the wrong firewall backend failed silently. Now no control counts until it has been tested from outside.',
    href: '/projects/security/',
  },
];

const timeline = [
  { y: '2021', t: 'Department of Energy CyberForce: 10th of 120 teams. Lewis University CTF: 1st.' },
  { y: '2022', t: 'CyberForce again: 5th of 160 teams. Collegiate Cyber Defense Competition (CCDC).' },
  { y: '2023', t: 'Security advisor intern: browser extension governance and risk exceptions.' },
  { y: '2024', t: 'B.S. Cybersecurity, Lewis University. Joined an IT security rotational program at a Fortune 500 insurer.' },
  { y: '2025', t: 'M.S. Cybersecurity, Lewis University (4+1 program).' },
  { y: '2026', t: 'Cloud security analyst at the same insurer. At home: a homelab run like production, a manga reader fork at 21 releases, a fix merged into Mealie.' },
];

const shelf = [
  'Return of the Blossoming Blade',
  'Nano Machine',
  'Revenge of the Baskerville Bloodhound',
  'SSS-Class Revival Hunter',
  "Nebula's Civilization",
  'The Game That I Came From',
];

const positions = [
  {
    claim: 'The guard has to be architectural, not textual.',
    body: '"Don\'t reveal X" in a prompt fails the first time someone is clever or insistent. The only defense that holds is an agent that doesn\'t possess the thing. Send it an injection and watch it have nothing to give up.',
    href: '/projects/jarvis/',
    cta: 'try to break it',
  },
  {
    claim: 'A control you have not attacked is a guess.',
    body: 'Same for a backup that has never been restored. I test both and publish what happened, including what failed.',
    href: '/projects/security/',
    cta: 'see what testing caught',
  },
  {
    claim: 'Prevention beats detection, and it is not close.',
    body: 'A control that evaluates at creation has no exposure window to measure. Detection\'s best case still costs you the lag plus however long a human takes.',
    href: '/projects/cloud-security/',
    cta: 'run the timeline',
  },
  {
    claim: 'Measure before you optimise, or you will spend the night on the wrong thing.',
    body: 'I instrumented my voice assistant expecting text-to-speech to be the bottleneck. It was the fastest stage in the pipeline.',
    href: '/projects/jarvis/',
    cta: 'build the pipeline',
  },
  {
    claim: 'Run what you build.',
    body: 'I ship my own images of the recipe app my household actually eats from, so every regression I write lands on the machine I use at dinner. It is the fastest feedback loop I have.',
    href: '/projects/mealie/',
    cta: 'see the bug',
  },
  {
    claim: 'Own the code, and "I wish it had X" becomes a thing you just do.',
    body: 'Twenty-one releases of a manga reader later, that has been true every time.',
    href: '/projects/makimono/',
    cta: 'drive the reader',
  },
];

const credentials = [
  {
    label: 'Education',
    items: [
      'M.S. Cybersecurity, Lewis University, 2025',
      'B.S. Cybersecurity, Lewis University, 2024 (4+1 program)',
    ],
  },
  {
    label: 'Certifications',
    items: [
      'Google Cloud Digital Leader',
      'ISC2 Certified in Cybersecurity (CC)',
      'Torq Automation Practitioner',
      'PADI certified diver',
    ],
  },
];
---

<Base
  title="About — Ethan Justice"
  path="/about/"
  description="Ethan Justice, cloud security analyst. How I got here, how I work, what I was wrong about, and what I am working on now."
>
  <div class="wrap">
    <PageHero
      kicker="About"
      title="About"
      headline="Hi, I'm Ethan."
      accent="Ethan"
      lede="I'm a cloud security analyst at a Fortune 500 insurer, where I work on GCP governance and security automation. At home I run my own infrastructure like production, and I attack it to see what holds."
      split
    >
      <figure class="portrait" slot="aside">
        <img
          src="/img/ethan-560.webp"
          srcset="/img/ethan-360.webp 360w, /img/ethan-560.webp 560w"
          sizes="(min-width: 900px) 280px, 60vw"
          width="560"
          height="560"
          alt="Ethan Justice, smiling, outdoors"
          decoding="async"
        />
      </figure>
    </PageHero>

    <div class="prose prose-wide">
      <p class="about-origin">
        I got into security through competitions. In CyberForce you defend a
        small network while a red team attacks it, and it taught me early that
        the exploit is never the interesting part. What matters is whether the
        system was built so the exploit had somewhere to go.
      </p>
      <p class="about-origin">
        My superpower is X-ray vision, or maybe future sight: when something is
        brought up, I immediately start thinking about where it can go wrong and
        how we can maneuver around those problems. In security that habit has a
        name, threat modeling. Away from the keyboard I dive, and I read a lot of manga, which is how my Android
        reader fork started.
      </p>

      <section class="now-block" aria-labelledby="now-h" data-card>
        <p class="label" id="now-h">Now · {updated}</p>
        <ul>
          {now.map((n) => (
            <li>
              {n.text}
              {n.href && (
                <>
                  {' '}
                  <a href={n.href}>{n.cta} →</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>

      <SectionHead label="Positions" title="What I actually think">
        <p>
          Anyone can assert these. So each one links to the place on this site
          where you can watch it hold.
        </p>
      </SectionHead>

      <ol class="positions">
        {
          positions.map((p) => (
            <li>
              <a class="pos-card" href={p.href} data-card>
                <span class="pos-claim">{p.claim}</span>
                <span class="pos-where">{p.body}</span>
                <span class="pos-cta">{p.cta} →</span>
              </a>
            </li>
          ))
        }
      </ol>

      <SectionHead label="How I work" title="Habits, not adjectives" />
      <ul class="work-list">
        {work.map((w) => (
          <li data-card>
            <span class="work-t">{w.t}</span>
            <span class="work-d">
              {w.d}
              {w.href && (
                <>
                  {' '}
                  <a href={w.href}>see it →</a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>

      <SectionHead label="Corrections" title="What I was wrong about" />
      <ul class="wrong-list">
        {wrong.map((w) => (
          <li data-card>
            <p class="wrong-was"><span class="label">I thought</span> {w.was}</p>
            <p class="wrong-now"><span class="label">Actually</span> {w.now} <a href={w.href}>the proof →</a></p>
          </li>
        ))}
      </ul>

      <SectionHead label="Timeline" title="How I got here" />
      <ol class="about-tl">
        {timeline.map((e) => (
          <li>
            <span class="tl-year">{e.y}</span>
            <span class="tl-text">{e.t}</span>
          </li>
        ))}
      </ol>

      <SectionHead label="Beyond work" title="The rest of it" />
      <p>
        PADI certified diver. I read a lot of manga and manhwa, mostly long
        action series, which is why Makimono exists: an itch to fix the reader I
        use every day. On the shelf right now:
      </p>
      <ul class="about-shelf" aria-label="Currently reading">
        {shelf.map((s) => (
          <li><span>{s}</span></li>
        ))}
      </ul>

      <SectionHead label="Credentials" title="On paper, briefly" />
      <div class="cred-grid" data-reveal>
        {
          credentials.map((c) => (
            <dl class="cred">
              <dt>{c.label}</dt>
              {c.items.map((i) => (
                <dd>{i}</dd>
              ))}
            </dl>
          ))
        }
      </div>

      <p class="page-hero-actions">
        <a class="btn btn-accent" href="/Ethan-Justice-Resume.pdf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
          </svg>
          Download résumé (PDF)
        </a>
      </p>
      <p class="muted fineprint">
        Web version: no phone number, no street address.
      </p>

      <SectionHead label="Contact" title="Where to find me" />
      <p>
        <a href="mailto:justice.ethan04@gmail.com">justice.ethan04@gmail.com</a>
        &nbsp;·&nbsp;
        <a href="https://www.linkedin.com/in/justice-ethan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/Tsuji-Hub" target="_blank" rel="noopener noreferrer">GitHub</a>
        &nbsp;·&nbsp;
        <a href="/.well-known/security.txt">security.txt</a>
      </p>
    </div>

    <div class="page-foot">
      <p class="label">More</p>
      <p><a class="back-all" href="/#work">← back to the work</a></p>
    </div>
  </div>
</Base>
