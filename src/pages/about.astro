---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';

// Structure follows the About-page research (claude/portfolio-research-about.md):
// a short top block with a real photo, a dated Now block, positions with
// receipts, how I work, what I was wrong about, a timeline, then the rest.
// Every fact here is checked against the résumé, the evidence file or a
// public source; nothing is padded.

const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const now = [
  { text: 'Going deeper on Torq: building security automation workflows past the practitioner certification.' },
  { text: 'Attacking every control in my homelab and publishing what held.', href: '/projects/security/', cta: 'the results' },
  { text: 'Rebuilding this site one page at a time, every number checked against a live source.' },
];

const work = [
  {
    t: 'I attack my own controls before I trust them.',
    d: 'A control counts once it has stopped something from outside, on the record. Four of mine failed that test the first time.',
    href: '/projects/security/',
  },
  {
    t: 'Detect, tune, then enforce.',
    d: 'New controls start in audit or detection-only mode against real traffic. They move to blocking when the false positives are known, not before.',
  },
  {
    t: 'Every risky change ships with its way back.',
    d: 'Firewall rollouts go host by host with a ten-minute auto-revert armed. Updates keep a rollback image and a snapshot until the new version has run for a few days.',
  },
  {
    t: 'Write it down while it happens.',
    d: 'Changes, tests and decisions go into a dated log as I make them, so the next person, usually me, does not have to guess.',
  },
];

const wrong = [
  {
    was: 'My VPN isolation held because no other route existed.',
    now: 'The route existed. What holds is a default-drop firewall in the namespace, and I trust it because I took the tunnel down six times and nothing got out.',
    href: '/projects/homelab/',
  },
  {
    was: 'fail2ban was banning attackers at my edge.',
    now: 'It logged bans and enforced none: the wrong firewall backend failed silently. Now no control counts until it has been tested from outside.',
    href: '/projects/security/',
  },
];

// Timeline: dates and bullets from LinkedIn (read 10-31) and the résumé.
// kind drives the dot colour: work, school, comp(etition), cert, home.
const timeline = [
  {
    y: '2021', kind: 'work', t: 'Electronics repair technician', when: 'Oct 2021 to Jul 2023 · Batteries Plus',
    pts: [
      'Diagnosed and repaired devices with visual, hands-on and computer-assisted testing.',
      'Wrote the estimates and work orders: parts, labor, and what was actually wrong.',
    ],
  },
  {
    y: '2021', kind: 'comp', t: 'First place, Lewis Cyber Flyer CTF', when: 'Capture the flag · Lewis University',
    pts: [],
  },
  {
    y: '2022', kind: 'comp', t: 'CyberForce: 5th of 160 teams', when: 'Department of Energy · defend a live network against a red team',
    pts: ['Also competed in the Collegiate Cyber Defense Competition (CCDC).'],
  },
  {
    y: '2023', kind: 'work', t: 'Security advisor intern', when: 'Summer 2023 · Fortune 500 insurer',
    pts: [
      'Worked with security leadership to find and reduce risk.',
      'Owned a project on governing browser extensions across the company.',
    ],
  },
  {
    y: '2023', kind: 'comp', t: 'CyberForce again: 10th', when: 'Three weeks, hosted by Argonne National Laboratory',
    pts: ['Aimed higher than the year before. Our defenses held, and I came out much stronger at Active Directory hardening through group policy.'],
  },
  {
    y: '2024', kind: 'school', t: 'B.S. Cybersecurity, Lewis University', when: '4+1 program, straight into the master\'s',
    pts: [],
  },
  {
    y: '2024', kind: 'work', t: 'IT security rotational program, rotation 1: Security Remediation Management', when: 'Jun 2024 to Jan 2025',
    pts: [
      'Ran security risk remediation in ServiceNow GRC: tracking, routing each issue to an owner, and getting vulnerabilities closed on time.',
      'Co-built the cloud security request intake in ServiceNow, replacing ad-hoc email with structured, trackable requests.',
      'With vulnerability management, routed Wiz cloud misconfiguration findings into the ticketing system.',
    ],
  },
  {
    y: '2025', kind: 'work', t: 'Rotation 2: Cloud Security', when: 'Jan 2025 to Apr 2026',
    pts: [
      'Validated metadata for 1,100+ GCP projects and linked each one to its business application in the CMDB.',
      'Defined the container security operating model: a RACI across 46 controls, agreed with cloud engineering, networking and AppSec.',
      'Recommended GCP organization policy constraints that block risky configurations at the source, moving from fixing to preventing.',
      'Automated the weekly security metrics report: a multi-hour manual job now takes minutes.',
    ],
  },
  {
    y: '2025', kind: 'cert', t: 'M.S. Cybersecurity, plus two certifications', when: 'Google Cloud Digital Leader (Feb) · M.S. (May) · ISC2 CC (Jul)',
    pts: [],
  },
  {
    y: '2026', kind: 'work', t: 'Cloud security analyst', when: 'Apr 2026 to now',
    pts: [
      'Assisted remediation management when unapproved pre-hardened container images were found: handled the ticket and saw it through to completion.',
      'Led a proof of concept of no-code SOAR platforms (Torq, Tines): workflows that enrich cloud vulnerability alerts automatically, demoed to leadership with an adoption roadmap.',
      'Wired Wiz findings into ServiceNow so tickets arrive with the asset owner and context already filled in.',
    ],
  },
  {
    y: '2026', kind: 'home', t: 'At home: a homelab run like production', when: 'Torq Automation Practitioner (Aug) · and still building',
    pts: [
      'Every security control attacked from outside and the results published.',
      'A manga reader fork at 21 releases, and a fix merged into Mealie.',
    ],
  },
];

const shelf = [
  { t: 'Steelheart', by: 'Brandon Sanderson', fav: true },
  { t: 'Return of the Blossoming Blade' },
  { t: 'Nano Machine' },
  { t: 'Revenge of the Baskerville Bloodhound' },
  { t: 'SSS-Class Revival Hunter' },
  { t: "Nebula's Civilization" },
];

const positions = [
  {
    claim: 'The guard has to be architectural, not textual.',
    body: '"Don\'t reveal X" in a prompt fails the first time someone is clever or insistent. The only defense that holds is an agent that doesn\'t possess the thing. Send it an injection and watch it have nothing to give up.',
    href: '/projects/jarvis/',
    cta: 'try to break it',
  },
  {
    claim: 'A control you have not attacked is a guess.',
    body: 'Same for a backup that has never been restored. I test both and publish what happened, including what failed.',
    href: '/projects/security/',
    cta: 'see what testing caught',
  },
  {
    claim: 'Prevention beats detection, and it is not close.',
    body: 'A control that evaluates at creation has no exposure window to measure. Detection\'s best case still costs you the lag plus however long a human takes.',
    href: '/projects/cloud-security/',
    cta: 'run the timeline',
  },
  {
    claim: 'Measure before you optimise, or you will spend the night on the wrong thing.',
    body: 'I instrumented my voice assistant expecting text-to-speech to be the bottleneck. It was the fastest stage in the pipeline.',
    href: '/projects/jarvis/',
    cta: 'see the numbers',
  },
  {
    claim: 'Run what you build.',
    body: 'I ship my own images of the recipe app my household actually eats from, so every regression I write lands on the machine I use at dinner. It is the fastest feedback loop I have.',
    href: '/projects/mealie/',
    cta: 'see the bug',
  },
  {
    claim: 'Own the code, and "I wish it had X" becomes a thing you just do.',
    body: 'Twenty-one releases of a manga reader later, that has been true every time.',
    href: '/projects/makimono/',
    cta: 'drive the reader',
  },
];

const credentials = [
  {
    label: 'Education',
    items: [
      'M.S. Cybersecurity, Lewis University, 2025',
      'B.S. Cybersecurity, Lewis University, 2024 (4+1 program)',
    ],
  },
  {
    label: 'Certifications',
    items: [
      'Google Cloud Digital Leader',
      'ISC2 Certified in Cybersecurity (CC)',
      'Torq Automation Practitioner',
      'PADI certified diver',
    ],
  },
];
---

<Base
  title="About — Ethan Justice"
  path="/about/"
  description="Ethan Justice, cloud security analyst. How I got here, how I work, what I was wrong about, and what I am working on now."
>
  <div class="wrap">
    <PageHero
      kicker="About"
      title="About"
      headline="Hi, I'm Ethan."
      accent="Ethan"
      lede="I'm a cloud security analyst at a Fortune 500 insurer, where I work on GCP governance and security automation. At home I run my own infrastructure like production, and I attack it to see what holds."
      split
    >
      <figure class="portrait" slot="aside" data-xray>
        <img
          src="/img/ethan-560.webp"
          srcset="/img/ethan-360.webp 360w, /img/ethan-560.webp 560w"
          sizes="(min-width: 900px) 280px, 60vw"
          width="560"
          height="560"
          alt="Ethan Justice, smiling, outdoors"
          decoding="async"
        />
        <span class="xray" aria-hidden="true"></span>
        <figcaption class="xray-cap" data-js-only>hover or tap: x-ray vision</figcaption>
      </figure>
    </PageHero>

    <div class="prose prose-wide">
      <p class="about-origin">
        I've always been the person who can't leave a problem alone. I chip
        away at it until it cracks, or it follows me around until it does. I was
        the one fixing the TV and the home internet, and I volunteered to film
        events at our town's yearly festival. CyberForce gave that habit a
        direction: keep a live network running while a red team tries to take
        it down.
      </p>
      <p class="about-origin">
        Give me a task with clear instructions and it gets done to the letter:
        every detail checked, every decision backed by data. Give me an open
        problem and I start with where it breaks. Call it X-ray vision. When a
        plan comes up, I'm already mapping where it can go wrong and how to get
        around it before it does. In security, that habit has a name: threat
        modeling.
      </p>

      <section class="now-block" aria-labelledby="now-h" data-card>
        <p class="label" id="now-h">Now · {updated}</p>
        <ul>
          {now.map((n) => (
            <li>
              {n.text}
              {n.href && (
                <>
                  {' '}
                  <a href={n.href}>{n.cta} →</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>

      <SectionHead label="Positions" title="What I actually think">
        <p>
          Anyone can assert these. So each one links to the place on this site
          where you can watch it hold.
        </p>
      </SectionHead>

      <ol class="positions">
        {
          positions.map((p) => (
            <li>
              <a class="pos-card" href={p.href} data-card>
                <span class="pos-claim">{p.claim}</span>
                <span class="pos-where">{p.body}</span>
                <span class="pos-cta">{p.cta} →</span>
              </a>
            </li>
          ))
        }
      </ol>

      <SectionHead label="How I work" title="Habits, not adjectives" />
      <ul class="work-list">
        {work.map((w) => (
          <li data-card>
            <span class="work-t">{w.t}</span>
            <span class="work-d">
              {w.d}
              {w.href && (
                <>
                  {' '}
                  <a href={w.href}>see it →</a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>

      <SectionHead label="Corrections" title="What I was wrong about" />
      <ul class="wrong-list">
        {wrong.map((w) => (
          <li data-card>
            <p class="wrong-was"><span class="label">I thought</span> {w.was}</p>
            <p class="wrong-now"><span class="label">Actually</span> {w.now} <a href={w.href}>the proof →</a></p>
          </li>
        ))}
      </ul>

      <SectionHead label="Timeline" title="How I got here" />
      <ol class="about-tl">
        {timeline.map((e, i) => (
          <li class={`tl-${e.kind}`}>
            <span class="tl-year">{i === 0 || timeline[i - 1].y !== e.y ? e.y : ''}</span>
            <div class="tl-body">
              <p class="tl-title">{e.t}</p>
              <p class="tl-when">{e.when}</p>
              {e.pts.length > 0 && (
                <ul class="tl-pts">
                  {e.pts.map((x) => <li>{x}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="tl-legend" aria-hidden="true">
        <span class="tl-work">work</span><span class="tl-comp">competition</span><span class="tl-school">school</span><span class="tl-cert">certification</span><span class="tl-home">homelab</span>
      </p>

      <SectionHead label="Beyond work" title="The rest of it" />
      <p>
        PADI certified diver. My favorite book series is Brandon Sanderson's
        Reckoners, starting with Steelheart. I also read a lot of manga and
        manhwa, mostly long action series, which is why Makimono exists: an
        itch to fix the reader I use every day. On the shelf right now:
      </p>
      <ul class="about-shelf" aria-label="Currently reading">
        {shelf.map((b) => (
          <li class:list={[b.fav && 'is-fav']} title={b.by ? `${b.t}, ${b.by}` : b.t}><span>{b.t}</span></li>
        ))}
      </ul>

      <SectionHead label="Credentials" title="On paper, briefly" />
      <div class="cred-grid" data-reveal>
        {
          credentials.map((c) => (
            <dl class="cred">
              <dt>{c.label}</dt>
              {c.items.map((i) => (
                <dd>{i}</dd>
              ))}
            </dl>
          ))
        }
      </div>

      <p class="page-hero-actions">
        <a class="btn btn-accent" href="/Ethan-Justice-Resume.pdf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
          </svg>
          Download résumé (PDF)
        </a>
      </p>
      <p class="muted fineprint">
        Web version: no phone number, no street address.
      </p>

      <SectionHead label="Contact" title="Where to find me" />
      <p>
        <a href="mailto:justice.ethan04@gmail.com">justice.ethan04@gmail.com</a>
        &nbsp;·&nbsp;
        <a href="https://www.linkedin.com/in/justice-ethan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/Tsuji-Hub" target="_blank" rel="noopener noreferrer">GitHub</a>
        &nbsp;·&nbsp;
        <a href="/.well-known/security.txt">security.txt</a>
      </p>
    </div>

    <div class="page-foot">
      <p class="label">More</p>
      <p><a class="back-all" href="/#work">← back to the work</a></p>
    </div>
  </div>
  <script is:inline src="/js/about-xray.js" defer></script>
</Base>
