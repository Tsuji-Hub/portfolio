---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.js';
import ev from '../data/security-evidence.json';

// Hero demo: recorded WAF verdicts from src/data/security-evidence.json.
// The first two layers (country filter, reputation) are the edge's real order
// of controls; the verdicts shown for them are the scenario (allowed country,
// clean address) except "Visit from abroad", which the geo filter drops (proven
// from a phone on cellular, 10-30). Everything from the WAF on is the recording.
const PICK: [string, string][] = [
  ['baseline', 'Normal visit'],
  ['sqli', 'SQL injection'],
  ['xss', 'Cross-site scripting'],
  ['traversal', 'Path traversal'],
  ['log4shell', 'Log4Shell'],
  ['env', 'Steal the .env file'],
];
const dec = (u: string) => { try { return decodeURIComponent(u); } catch { return u; } };
const atk = PICK.map(([id, label]) => {
  const r = ev.waf.requests.find((x) => x.id === id)!;
  const hdr = Object.entries(r.request.headers || {}).map(([k, v]) => `${k}: ${v}`).join('  ');
  const rule = r.inband.rules.find((x) => !x.id.startsWith('crowdsecurity/')) || r.inband.rules[0];
  return {
    id, label,
    line: `${r.request.verb} ${dec(r.request.uri)}${hdr ? '  ' + hdr : ''}`,
    blocked: r.inband.verdict === 'blocked',
    http: r.inband.http,
    score: r.crs.anomaly_score,
    rule: rule ? `${rule.id} ${rule.name}` : '',
  };
});
const banAfter = ev.waf.ban.after_blocked_requests;
const dropS = ev.ban_enforcement.reps.map((r) => r.ban_to_drop_s);
const dropRange = `${Math.min(...dropS).toFixed(1)}-${Math.max(...dropS).toFixed(1)} s`;
const blockedN = ev.waf.requests.filter((r) => r.id !== 'baseline' && r.id !== 'wordpress' && r.inband.verdict === 'blocked').length;
const payloadN = ev.waf.requests.filter((r) => r.id !== 'baseline' && r.id !== 'wordpress').length;

// The bento's feature tile is 2x2 and has to be placed first for auto-flow to
// land it top-left. Presentation order only; the data file is untouched.
// Feature tile first, then two tiles beside it, then security across a full
// row (grid-auto-flow: dense fills any gap at narrower widths).
const rest = projects.filter((p) => p.slug !== 'cloud-security' && p.slug !== 'security');
const ordered = [
  ...projects.filter((p) => p.slug === 'cloud-security'),
  ...rest.slice(0, 2),
  ...projects.filter((p) => p.slug === 'security'),
  ...rest.slice(2),
];

// Inline icon paths. No icon font, no library, no extra request.
const ICONS: Record<string, string> = {
  'cloud-security':
    '<path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97 6 6 0 0 0-11.66-1.4A4 4 0 0 0 6.5 19z"/><path d="m9.5 14.5 1.8 1.8 3.4-3.6"/>',
  makimono:
    '<rect x="5" y="2" width="14" height="20" rx="2.5"/><line x1="10.5" y1="18.5" x2="13.5" y2="18.5"/>',
  homelab:
    '<rect x="2.5" y="3" width="19" height="7" rx="1.5"/><rect x="2.5" y="14" width="19" height="7" rx="1.5"/><line x1="6.5" y1="6.5" x2="6.6" y2="6.5"/><line x1="6.5" y1="17.5" x2="6.6" y2="17.5"/>',
  jarvis:
    '<path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M5.5 10.5V11a6.5 6.5 0 0 0 13 0v-.5"/><line x1="12" y1="17.5" x2="12" y2="21.5"/>',
  mealie:
    '<path d="M4 2.5v7a2.5 2.5 0 0 0 5 0v-7"/><line x1="6.5" y1="9.5" x2="6.5" y2="21.5"/><path d="M16 2.5c-1.5 1.5-2 3.5-2 5.5s.5 3 2 3.5v10"/><path d="M20 2.5v19"/>',
  security:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
  site:
    '<rect x="4" y="10.5" width="16" height="10.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
};
---

<Base title="Ethan Justice — Cloud Security Analyst" path="/">
  <div class="wrap">
    <section class="hero-split">
      <div>
        <p class="label hero-eyebrow">
          Cloud security analyst · governance · automation
        </p>
        <h1 class="hero-title">Ethan Justice</h1>
        <p class="hero-lede">
          I govern cloud environments for a Fortune 500 insurer by day, and run
          my own infrastructure <span class="accent text-glow">like production</span>
          by night.
        </p>

        <div class="hero-actions" data-reveal>
          <a class="btn btn-accent" href="#work">
            See the work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" />
            </svg>
          </a>
          <a class="btn" href="/Ethan-Justice-Resume.pdf">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
            </svg>
            Résumé
          </a>
        </div>

        <dl class="hero-stats" data-reveal>
          <div>
            <dt>1,100+</dt>
            <dd>GCP projects mapped to owners</dd>
          </div>
          <div>
            <dt>21</dt>
            <dd>Makimono releases shipped</dd>
          </div>
          <div>
            <dt>{blockedN}/{payloadN}</dt>
            <dd>attacks blocked at my edge</dd>
          </div>
          <div>
            <dt>13.7k★</dt>
            <dd>Mealie: my fix merged upstream</dd>
          </div>
        </dl>
      </div>

      <div class="ah" data-ah data-ban-after={banAfter} data-drop={dropRange}>
        <div class="ah-head">
          <span class="label">attack my edge</span>
          <span class="live"><span class="dot" aria-hidden="true"></span>real verdicts</span>
        </div>
        <p class="ah-lead">
          Pick an attack and watch what my homelab's front door did when I sent
          exactly that from outside.
        </p>
        <div class="ah-pick" data-js-only role="group" aria-label="Pick a request">
          {atk.map((a) => (
            <button class:list={['ah-btn', a.blocked && 'is-attack']} type="button" data-ah-req={JSON.stringify(a).replace(/</g, "\\u003c")} aria-pressed="false">{a.label}</button>
          ))}
          <button class="ah-btn is-abroad" type="button" data-ah-abroad aria-pressed="false">Visit from abroad</button>
        </div>
        <div class="ah-foot" data-js-only>
          <span class="ah-strikes" aria-hidden="true" data-ah-strikes>
            {Array.from({ length: banAfter }).map(() => <i></i>)}
          </span>
          <span class="ah-ban" data-ah-ban aria-live="polite">Strikes 0 of {banAfter}. {banAfter} blocked attacks from one address = 24 h ban.</span>
        </div>
        <div class="ah-banned" data-ah-banned hidden>
          <p><strong>You're banned for 24 h</strong>, exactly as a real attacker would be. The firewall now drops everything from your address, even a normal visit.</p>
          <button class="ah-reset" type="button" data-ah-reset>Unban me and try again</button>
        </div>
        <code class="ah-line" data-ah-line data-js-only>choose a request above</code>
        <ol class="ah-layers" data-js-only>
          <li data-l="geo"><span class="ah-n">1</span><span class="ah-name">Country filter<small>firewall, before anything else</small></span><span class="ah-v" data-v></span></li>
          <li data-l="rep"><span class="ah-n">2</span><span class="ah-name">Reputation<small>known attackers are dropped</small></span><span class="ah-v" data-v></span></li>
          <li data-l="waf"><span class="ah-n">3</span><span class="ah-name">WAF · OWASP CRS<small><span class="ah-bar" aria-hidden="true"><i data-ah-fill></i><b></b></span> score <span data-ah-score>0</span> / block at 5</small></span><span class="ah-v" data-v></span></li>
          <li data-l="app"><span class="ah-n">4</span><span class="ah-name">Proxy → app<small>TLS ends here, logs redacted</small></span><span class="ah-v" data-v></span></li>
        </ol>
        <p class="ah-out" data-ah-out aria-live="polite" data-js-only></p>

        <p class="ah-more" data-js-only><a href="/projects/security/">Every rule and score, and what my own testing caught →</a></p>
        <p class="ah-static js-required">
          {blockedN} of {payloadN} attack payloads blocked with a 403 by the WAF,
          normal traffic untouched, repeat offenders banned at the firewall in
          {dropRange}. <a href="/projects/security/">The full evidence →</a>
        </p>
      </div>
    </section>

    <section class="selftest" id="selftest" data-selftest>
      <h2 class="section-label">this page is the first exhibit</h2>
      <p class="selftest-intro">
        The hero tests my homelab. This tests the page you are on. Each button
        runs a real attack against it in your browser, and the verdict is the
        browser's own: its content security policy refuses the attack and
        reports why.
      </p>

      <p class="js-required">
        These attacks run in JavaScript, which is off in your browser. The page
        still works without it, which is part of the same point.
      </p>

      <div class="map-controls js-only">
        <button class="map-btn" type="button" data-atk="all">run all →</button>
        <span class="sep"></span>
        <button class="map-btn" type="button" data-atk="eval">eval()</button>
        <button class="map-btn" type="button" data-atk="fn">new Function()</button>
        <button class="map-btn" type="button" data-atk="inline">inject a script</button>
        <button class="map-btn" type="button" data-atk="style">inject a style</button>
        <button class="map-btn" type="button" data-atk="cdn">load a CDN</button>
        <button class="map-btn" type="button" data-atk="fetch">phone home</button>
      </div>

      <ol class="atk-list" data-atk-list aria-live="polite"></ol>

      <div class="policy" data-policy hidden>
        <p class="possess-label">the policy your browser reports enforcing, read from its own violation event</p>
        <code data-policy-text></code>
      </div>

    </section>

    <section id="work" class="work">
      <div class="work-head">
        <div>
          <p class="label">Selected work</p>
          <h2>Things I built, and what they prove.</h2>
        </div>
        <svg class="shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />
        </svg>
      </div>

      <div class="bento">
        {
          ordered.map((p) => (
            <a
              class:list={['tile', 'bento-tile', p.slug === 'cloud-security' && 'tile-feature', p.slug === 'security' && 'tile-wide']}
              href={`/projects/${p.slug}/`}
              data-card
            >
              <div class="tile-top">
                <span class="tile-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[p.slug]} />
                </span>
                <svg class="tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
                </svg>
              </div>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              {p.highlights && (
                <ul class="tile-highlights">
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <ul class="tags" aria-label="Stack">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <span class="tile-cta">{p.demo} →</span>
            </a>
          ))
        }

        <a class="tile bento-tile" href="#selftest" data-card>
          <div class="tile-top">
            <span class="tile-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.site} />
            </span>
            <svg class="tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
            </svg>
          </div>
          <h3>This site</h3>
          <p>
            Static, self-hosted fonts, zero third-party requests, strict CSP. It
            does not ask you to believe that: it attacks itself and prints the
            browser's own verdict.
          </p>
          <ul class="tags" aria-label="Stack">
            <li>Astro</li>
            <li>No JS frameworks</li>
            <li>CSP</li>
          </ul>
          <span class="tile-cta">attack it →</span>
        </a>
      </div>
    </section>
  </div>

  <script is:inline src="/js/attack-hero.js" defer></script>
  <script is:inline src="/js/selftest.js" defer></script>
</Base>
