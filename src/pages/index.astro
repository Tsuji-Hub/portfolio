---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.js';
---

<Base title="Ethan Justice — Cloud Security Analyst" path="/">
  <div class="wrap">
    <section class="hero-split">
      <div>
        <p class="label hero-eyebrow" data-reveal>
          Cloud security analyst · governance · automation
        </p>
        <h1 class="hero-title" data-reveal>Ethan Justice</h1>
        <p class="hero-lede" data-reveal>
          I govern cloud environments for a Fortune 500 insurer by day, and run
          my own infrastructure <span class="accent text-glow">like production</span>
          by night.
        </p>

        <div class="hero-actions" data-reveal>
          <a class="btn btn-accent" href="#work">
            See the work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" />
            </svg>
          </a>
          <a class="btn" href="/Ethan-Justice-Resume.pdf">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
            </svg>
            Résumé
          </a>
        </div>

        <dl class="hero-stats" data-reveal>
          <div>
            <dt>1,100+</dt>
            <dd>GCP projects governed</dd>
          </div>
          <div>
            <dt>11</dt>
            <dd>releases shipped</dd>
          </div>
          <div>
            <dt>13</dt>
            <dd>containers, tested restores</dd>
          </div>
          <div>
            <dt>12.7k★</dt>
            <dd>project, one fix of mine open</dd>
          </div>
        </dl>
      </div>

      <div data-canvas>
        <div class="hero-canvas">
          <div class="hero-canvas-head">
            <span class="label">homelab · live topology</span>
            <span class="live"><span class="dot" aria-hidden="true"></span>sanitized</span>
          </div>
          <canvas
            data-topology
            role="img"
            aria-label="Diagram of a self-hosted homelab: a hypervisor at the centre linked to storage, a GPU media VM, containers, a VPN namespace, a TLS proxy, monitoring and nightly backups."
          ></canvas>
        </div>
      </div>
    </section>

    <section class="selftest" data-selftest>
      <h2 class="section-label">this page is the first exhibit</h2>
      <p class="selftest-intro">
        I could tell you I take this seriously. Instead: attack it. Every button
        below runs a real attack against this page, in your browser, right now.
        Nothing is simulated and none of the verdicts are written by me — they
        are the browser refusing, and reporting why.
      </p>

      <div class="map-controls">
        <button class="map-btn" type="button" data-atk="all">run all →</button>
        <span class="sep"></span>
        <button class="map-btn" type="button" data-atk="eval">eval()</button>
        <button class="map-btn" type="button" data-atk="fn">new Function()</button>
        <button class="map-btn" type="button" data-atk="inline">inject a script</button>
        <button class="map-btn" type="button" data-atk="style">inject a style</button>
        <button class="map-btn" type="button" data-atk="cdn">load a CDN</button>
        <button class="map-btn" type="button" data-atk="fetch">phone home</button>
      </div>

      <ol class="atk-list" data-atk-list aria-live="polite"></ol>

      <div class="policy" data-policy hidden>
        <p class="possess-label">the policy your browser reports enforcing, read from its own violation event</p>
        <code data-policy-text></code>
      </div>

      <p class="selftest-intro">
        And here is everything this page fetched to show you itself. Not a claim
        in a footer — your browser's own record, counted against this domain.
      </p>

      <div class="manifest" data-manifest>
        <div class="manifest-head">
          <span><b data-mf-count>—</b> requests</span>
          <span><b data-mf-weight>—</b> transferred</span>
          <span class="manifest-verdict" data-mf-verdict>counting…</span>
        </div>
        <ul class="manifest-list" data-mf-list></ul>
      </div>
    </section>

    <h2 class="section-label">projects</h2>
    <div class="project-grid">
      {
        projects.map((p) => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <h3>{p.title}</h3>
            <p>{p.blurb}</p>
            <ul class="tags" aria-label="Stack">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <span class="arrow">{p.demo} →</span>
          </a>
        ))
      }
    </div>
  </div>

  <script is:inline src="/js/topology.js" defer></script>
  <script>import "../scripts/reveal.ts";</script>
  <script is:inline src="/js/selftest.js" defer></script>
  <script is:inline src="/js/manifest.js" defer></script>
</Base>
